{
  "name": "@texoport/commands",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Private Effect-powered maintenance commands for the @texoport monorepo.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "test": "pnpm build && pnpm -r run test",
    "check": "pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "command": "node --experimental-strip-types main.ts",
    "setup:npm-publishers": "node --experimental-strip-types main.ts trust-npm-publishers"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/platform-node": "4.0.0-beta.104",
    "@types/node": "^24.13.3",
    "effect": "4.0.0-beta.104",
    "typescript": "^5.9.3"
  }
}
