{
  "name": "@texoport/effect-ai",
  "private": true,
  "version": "0.0.0",
  "description": "Effect AI providers powered by local Claude Code and Codex subscriptions.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "test": "pnpm build && pnpm -r run test",
    "check": "pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
