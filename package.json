{
  "name": "effect-ai-subs",
  "version": "0.1.0",
  "description": "Effect AI LanguageModel providers that bill against your Claude Code / ChatGPT (Codex) subscriptions via local CLIs",
  "keywords": [
    "effect",
    "effect-ai",
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "subscription",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/ClaudeLanguageModel.d.ts",
      "import": "./dist/ClaudeLanguageModel.js"
    },
    "./codex": {
      "types": "./dist/CodexLanguageModel.d.ts",
      "import": "./dist/CodexLanguageModel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/prompt.test.ts test/response.test.ts test/envelopes.test.ts",
    "example:claude": "node --experimental-strip-types examples/claude.ts",
    "example:codex": "node --experimental-strip-types examples/codex.ts",
    "example:codex-tools": "node --experimental-strip-types examples/codex-tools.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@effect/ai": "^0.37.0",
    "@effect/platform": "^0.97.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/ai": "^0.37.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.97.1",
    "@types/node": "^24.13.3",
    "effect": "^3.22.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
