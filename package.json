{
  "name": "@texoport/commands",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Texoport's Effect libraries.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck --filter='./packages/*'",
    "test": "turbo run test --filter='./packages/*'",
    "check": "pnpm typecheck && pnpm test",
    "bench": "turbo run bench --filter='./packages/*'",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "command": "node --experimental-strip-types main.ts",
    "setup:npm-publishers": "node --experimental-strip-types main.ts trust-npm-publishers"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/platform-node": "4.0.0-beta.104",
    "@types/node": "^24.13.3",
    "effect": "4.0.0-beta.104",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
